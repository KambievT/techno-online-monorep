{
  "name": "andikis2009-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "pnpm@10",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "bootstrap": "pnpm install",
    "build": "pnpm -w -r run build",
    "dev": "pnpm -w -r run dev",
    "start": "pnpm -w -r run start",
    "lint": "pnpm -w -r run lint"
  },
  "devDependencies": {
    "pnpm": "^8"
  }
}
